# Copy to .env.local for local dev, and add the same keys to
# Vercel → Project Settings → Environment Variables for deploys.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=your-smtp-account@gmail.com
EMAIL_PASS=your-gmail-app-password

# Display name used in the contact form's outgoing "From" header.
EMAIL_SENDER_NAME=Your Name — Portfolio

# Where verified contact-form messages are forwarded.
CONTACT_TO_EMAIL=you@example.com

# Secret used to HMAC-sign the short-lived OTP verification token.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_TOKEN_SECRET=replace-with-a-random-64-char-hex-string
